# Choose one authentication method. Never commit a populated .env file.

# Method A: let oopz-sdk log in with the account and password.
OOPZ_LOGIN_METHOD=auto
OOPZ_LOGIN_PHONE=
OOPZ_LOGIN_PASSWORD=

# Method B: provide existing low-level credentials instead.
# OOPZ_DEVICE_ID=
# OOPZ_PERSON_UID=
# OOPZ_JWT_TOKEN=
# OOPZ_PRIVATE_KEY=

# Optional OOPZ client version override.
# OOPZ_APP_VERSION=

# Part 2 analysis API. Route 5 supports any provider exposing an OpenAI Chat
# Completions-compatible HTTPS endpoint.  Use openai-compatible for a generic
# provider; use deepseek or opencode-go for their compatibility defaults.
# Real keys live only in the gitignored .env at the project root; every CLI
# loads it automatically at startup (shell-set variables take priority).
ANALYZER_PROVIDER=opencode-go
ANALYZER_API_KEY=
ANALYZER_BASE_URL=https://opencode.ai/zen/go/v1
ANALYZER_MODEL=mimo-v2.5
ANALYZER_TIMEOUT_SECONDS=60
ANALYZER_MAX_RETRIES=3
ANALYZER_MIN_INTERVAL_SECONDS=0.5
ANALYZER_MAX_TOKENS=2048
ANALYZER_THINKING_MAX_TOKENS=16384
# auto sends vendor thinking parameters only to DeepSeek/OpenCode Go; set
# enabled only after confirming the relay supports them.  For generic APIs,
# disabled is the safe choice.  Turn JSON mode off only if the provider rejects
# the standard response_format=json_object parameter.
ANALYZER_THINKING_MODE=auto
ANALYZER_JSON_MODE=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_MIN_INTERVAL_SECONDS=0.5
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_THINKING_MAX_TOKENS=16384

# OpenCode Go is the default relay. The raw API model ID does not include
# the OpenCode config prefix.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=mimo-v2.5

# Part 3 QQ command core. The controller defaults to deny-all.
OOPZ_QQ_ALLOWED_SENDERS=
OOPZ_QQ_ADMIN_IDS=
OOPZ_QQ_ALLOWED_CHATS=
OOPZ_RECORDING_CONSENT_CONFIRMED=false
OOPZ_OUTPUT_ROOT=output
OOPZ_QQ_STATE_ROOT=controller_state
OOPZ_CHUNK_SECONDS=300
OOPZ_TRANSCRIPTION_REPAIR_ATTEMPTS=1
OOPZ_QQ_REPORT_FLOW_TIMEOUT_SECONDS=180
OOPZ_CUTOFF_LOCAL_HOUR=4
OOPZ_EMPTY_CHANNEL_TIMEOUT_SECONDS=300
OOPZ_LANGUAGE=auto
OOPZ_RETAIN_AUDIO=false
OOPZ_RETENTION_HOURS=168
OOPZ_DEVICE=cpu
OOPZ_ANALYSIS_MAX_PARALLELISM=4
# Long-recording resilience. Membership failures never stop RTC capture.
OOPZ_MEMBERSHIP_REFRESH_SECONDS=30
OOPZ_MEMBERSHIP_TIMEOUT_SECONDS=10
OOPZ_CONNECTION_CHECK_SECONDS=2
OOPZ_DISCONNECT_GRACE_SECONDS=15
OOPZ_BROWSER_OPERATION_TIMEOUT_SECONDS=2
OOPZ_RECONNECT_WINDOW_SECONDS=300
OOPZ_RECONNECT_INITIAL_DELAY_SECONDS=1
OOPZ_RECONNECT_MAX_DELAY_SECONDS=30
OOPZ_RECONNECT_ATTEMPT_TIMEOUT_SECONDS=30

# Milestones 20-21: NapCatQQ / OneBot 11. Keep every listener on loopback.
OOPZ_ONEBOT_WS_URL=ws://127.0.0.1:3001
OOPZ_ONEBOT_ACCESS_TOKEN=
OOPZ_QQ_ADMIN_ID=
OOPZ_QQ_REPORT_GROUP_ID=
OOPZ_QQ_REPORT_FRIEND_ID=
OOPZ_QQ_REPORT_GROUP_ENABLED=false
OOPZ_ONEBOT_CONTROLLER_TIMEOUT_SECONDS=30
OOPZ_ONEBOT_ACTION_TIMEOUT_SECONDS=15
OOPZ_ONEBOT_SEND_FAILURE_COOLDOWN_SECONDS=30
OOPZ_QQ_WATCHDOG_POLL_SECONDS=10
OOPZ_QQ_WATCHDOG_PORT_GRACE_SECONDS=60
OOPZ_QQ_WATCHDOG_GATEWAY_GRACE_SECONDS=45
OOPZ_QQ_WATCHDOG_ESCALATION_SECONDS=120
OOPZ_ONEBOT_RECONNECT_MIN_SECONDS=1
OOPZ_ONEBOT_RECONNECT_MAX_SECONDS=30
# Do not enable unless a protected private network and firewall are configured.
OOPZ_ONEBOT_ALLOW_REMOTE=false

# Local Qwen route (Ollama; 300-second and 60-minute summaries only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_MAX_RETRIES=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_TOKENS=16384
OLLAMA_THINKING_TIMEOUT_SECONDS=30
