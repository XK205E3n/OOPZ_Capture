# 复制为 .env 后填写；.env 含敏感信息，只保留在本机，禁止提交到 Git。

# === 飞书机器人：启动必填 ===
# 机器人应用身份。
OOPZ_FEISHU_APP_ID=
OOPZ_FEISHU_APP_SECRET=

# === 飞书机器人：控制群 ID ===
# 可手动填写；留空时启动机器人，然后将其邀请至目标群，程序会自动保存且不再覆盖。
OOPZ_FEISHU_ADMIN_CHAT_ID=

# === 飞书机器人：默认运行值 ===
OOPZ_FEISHU_STATE_ROOT=feishu_state

# === OOPZ 录制和转写：启动必填 ===
OOPZ_LOGIN_PHONE=
OOPZ_LOGIN_PASSWORD=

# === OOPZ 录制和转写：可选兼容项 ===
# 通常无需设置；未设置时使用 SDK 内置客户端版本。
# OOPZ_APP_VERSION=

# === OOPZ 录制和转写：默认运行值 ===
OOPZ_OUTPUT_ROOT=output
OOPZ_CHUNK_SECONDS=300
OOPZ_TRANSCRIPTION_REPAIR_ATTEMPTS=1
OOPZ_PROCESSING_DEADLINE_SECONDS=900
OOPZ_POLL_INTERVAL_SECONDS=0.25
OOPZ_CUTOFF_LOCAL_HOUR=4
OOPZ_EMPTY_CHANNEL_TIMEOUT_SECONDS=300
OOPZ_LANGUAGE=auto
OOPZ_RETAIN_AUDIO=false
OOPZ_RETENTION_HOURS=720
OOPZ_DEVICE=cpu
OOPZ_MEMBERSHIP_REFRESH_SECONDS=30
OOPZ_MEMBERSHIP_TIMEOUT_SECONDS=10
OOPZ_CONNECTION_CHECK_SECONDS=2
OOPZ_DISCONNECT_GRACE_SECONDS=15
OOPZ_BROWSER_OPERATION_TIMEOUT_SECONDS=2
OOPZ_RECONNECT_WINDOW_SECONDS=300
OOPZ_RECONNECT_INITIAL_DELAY_SECONDS=1
OOPZ_RECONNECT_MAX_DELAY_SECONDS=30
OOPZ_RECONNECT_ATTEMPT_TIMEOUT_SECONDS=30

# === 分析器与出图（Qoder CN CLI）：启动必填 ===
# 分析用服务器上已登录的 Qoder CN CLI（无头纯文本补全，免费 Qwen 模型）；不再使用任何 HTTP API 密钥。
# CLI 可执行文件路径，及它的 HOME（保存其登录，运行用户必须可读写）。
OOPZ_ANALYZER_CLI=
OOPZ_ANALYZER_HOME=
OOPZ_ANALYZER_MODEL=Qwen3.8-Flash
# 单次模型调用超时秒数（单次通常 25-280 秒）。
OOPZ_ANALYZER_TIMEOUT_SECONDS=900
# 出图字体目录（NotoSansSC 等，不入 Git）；用 scripts/download_fonts.py 下载。留空使用 assets/fonts。
OOPZ_FONT_DIR=

# === 跨平台运行路径（可选） ===
# 在启动进程环境中设置 OOPZ_ENV_FILE；不从 .env 内二次重定向。
# 优先级：显式 env_path > 进程 OOPZ_ENV_FILE > 项目根 .env；进程已有变量优先。
# 相对配置文件路径基于发布目录；Linux 安装器使用 shared/config/.env 的绝对路径。
# OOPZ_ENV_FILE=/opt/oopz/shared/config/.env
# Node 可执行文件路径（不是目录），Qoder CLI 需要；留空自动查找。
OOPZ_NODE_PATH=
# 可选 Playwright 浏览器缓存根目录。
# PLAYWRIGHT_BROWSERS_PATH=/opt/oopz/shared/browsers

# === 可选隔离录音转写验证模式（默认关闭）===
# 网关启动不开始录音；频道选择后由发起人确认已告知参与者，才创建录音请求。
# 强制CPU和音频保留，禁用分析、出图和清理。
OOPZ_CAPTURE_ONLY=false
# 每次启动都必须使用全新/空的绝对目录，且与普通目录及彼此不重叠。
OOPZ_CAPTURE_ONLY_STATE_ROOT=
OOPZ_CAPTURE_ONLY_OUTPUT_ROOT=
