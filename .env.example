# 复制为 .env 后填写；.env 含敏感信息，只保留在本机，禁止提交到 Git。

# === 飞书机器人：启动必填 ===
# 机器人应用身份。
OOPZ_FEISHU_APP_ID=
OOPZ_FEISHU_APP_SECRET=

# === 飞书机器人：控制群 ID ===
# 可手动填写；留空时启动机器人，然后将其邀请至目标群，程序会自动保存且不再覆盖。
OOPZ_FEISHU_ADMIN_CHAT_ID=

# === 飞书公开报告和索引：启用发布或远程删除时必填 ===
OOPZ_FEISHU_PUBLIC_FOLDER_TOKEN=
OOPZ_FEISHU_BASE_APP_TOKEN=
OOPZ_FEISHU_BASE_TABLE_ID=
OOPZ_FEISHU_PUBLIC_INDEX_URL=

# === 飞书机器人：默认运行值 ===
OOPZ_FEISHU_STATE_ROOT=feishu_state

# === OOPZ 录制和转写：启动必填 ===
OOPZ_LOGIN_PHONE=
OOPZ_LOGIN_PASSWORD=

# === OOPZ 录制和转写：可选兼容项 ===
# 通常无需设置；未设置时使用 SDK 内置客户端版本。
# OOPZ_APP_VERSION=

# === OOPZ 录制和转写：默认运行值 ===
OOPZ_OUTPUT_ROOT=output
OOPZ_CHUNK_SECONDS=300
OOPZ_TRANSCRIPTION_REPAIR_ATTEMPTS=1
OOPZ_PROCESSING_DEADLINE_SECONDS=900
OOPZ_POLL_INTERVAL_SECONDS=0.25
OOPZ_CUTOFF_LOCAL_HOUR=4
OOPZ_EMPTY_CHANNEL_TIMEOUT_SECONDS=300
OOPZ_LANGUAGE=auto
OOPZ_RETAIN_AUDIO=false
OOPZ_RETENTION_HOURS=360
OOPZ_DEVICE=cpu
OOPZ_MEMBERSHIP_REFRESH_SECONDS=30
OOPZ_MEMBERSHIP_TIMEOUT_SECONDS=10
OOPZ_CONNECTION_CHECK_SECONDS=2
OOPZ_DISCONNECT_GRACE_SECONDS=15
OOPZ_BROWSER_OPERATION_TIMEOUT_SECONDS=2
OOPZ_RECONNECT_WINDOW_SECONDS=300
OOPZ_RECONNECT_INITIAL_DELAY_SECONDS=1
OOPZ_RECONNECT_MAX_DELAY_SECONDS=30
OOPZ_RECONNECT_ATTEMPT_TIMEOUT_SECONDS=30

# === 分析器：全部启动必填，不提供隐式默认值 ===
# 用户必须根据实际 API 账户填写每一项。模型仅推荐 MiMo V2.5。
# 不推荐特定供应商；provider、API 地址和实际模型标识均按所选服务填写。
ANALYZER_PROVIDER=
ANALYZER_API_KEY=
ANALYZER_BASE_URL=
ANALYZER_MODEL=
# 云端较慢模型建议单次请求超时 180 秒（范围 1-600）；重试次数不含首次请求。
ANALYZER_TIMEOUT_SECONDS=
ANALYZER_MAX_RETRIES=
ANALYZER_MIN_INTERVAL_SECONDS=
ANALYZER_MAX_TOKENS=
ANALYZER_THINKING_MAX_TOKENS=
# enabled 在短摘要、长摘要、最终综合均开启思考；不指定强度，使用服务端默认。
# 百炼官方兼容端点的 qwen3.8-flash：disabled/auto 显式关闭思考。
ANALYZER_THINKING_MODE=
# 可选：更换代理地址/模型时按服务商 API 选择 auto/standard/deepseek/qwen。
# qwen 使用 enable_thinking；deepseek 使用 thinking.type；standard 不发送厂商扩展。
ANALYZER_THINKING_FORMAT=auto
ANALYZER_JSON_MODE=
# 分析窗口并行度不是 API 接入凭据，继续保留项目默认值 4。
OOPZ_ANALYSIS_MAX_PARALLELISM=4

# === 跨平台运行路径（可选） ===
# 在启动进程环境中设置 OOPZ_ENV_FILE；不从 .env 内二次重定向。
# 优先级：显式 env_path > 进程 OOPZ_ENV_FILE > 项目根 .env；进程已有变量优先。
# 相对配置文件路径基于发布目录；Linux 安装器使用 shared/config/.env 的绝对路径。
# OOPZ_ENV_FILE=/opt/oopz/shared/config/.env
# Node 可执行文件路径（不是目录），要求 >=22.12.0；留空自动查找。
OOPZ_NODE_PATH=
# 可选 Playwright 浏览器缓存根目录；录音与 PDF 应使用同一运行用户/缓存。
# PLAYWRIGHT_BROWSERS_PATH=/opt/oopz/shared/browsers
# 可选 PDF 浏览器绝对路径；留空自动查找 Playwright 缓存及 Chrome/Edge。
# Linux prepare 的沙箱检查也接受进程环境中的同名路径覆盖；不会关闭浏览器沙箱。
# Ubuntu 中文 PDF 需要 fontconfig 和 fonts-noto-cjk。
MD_TO_PDF_CHROME_PATH=
# PDF 引擎必须明确选择；未设置时保持 chromium，不会失败后自动切换。
# Linux 可设 weasyprint（需安装项目 pdf extra 和 Pango）；Windows 保持 chromium。
OOPZ_PDF_BACKEND=chromium

# === 可选隔离录音转写验证模式（默认关闭）===
# 网关启动不开始录音；频道选择后由发起人确认已告知参与者，才创建录音请求。
# 强制CPU和音频保留，禁用分析、报告、发布和清理。
OOPZ_CAPTURE_ONLY=false
# 每次启动都必须使用全新/空的绝对目录，且与普通目录及彼此不重叠。
OOPZ_CAPTURE_ONLY_STATE_ROOT=
OOPZ_CAPTURE_ONLY_OUTPUT_ROOT=
