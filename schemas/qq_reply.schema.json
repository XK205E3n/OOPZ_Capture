{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oopz.qq.reply.v1",
  "title": "QQ command reply",
  "type": "object",
  "required": ["schema_version", "reply_id", "message_id", "command", "status", "at", "target", "text"],
  "properties": {
    "schema_version": {"const": "oopz.qq.reply.v1"},
    "reply_id": {"type": "string", "format": "uuid"},
    "message_id": {"type": "string", "format": "uuid"},
    "command": {"enum": ["start_capture", "leave_channel", "status", "help", "invalid", "unauthorized"]},
    "status": {"enum": ["accepted", "completed", "rejected"]},
    "at": {"type": "string", "format": "date-time"},
    "target": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {"type": {"enum": ["group", "private"]}, "id": {"type": "string"}}
    },
    "text": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "anyOf": [{"format": "uuid"}, {"pattern": "^\\d{4}-\\d{2}-\\d{2}_\\d{2}-\\d{2}-\\d{2}_BJT(?:-\\d{2,3})?$"}]},
    "session_status": {"type": "string"}
  }
}
