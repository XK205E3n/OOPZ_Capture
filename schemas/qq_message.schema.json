{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oopz.qq.message.v1",
  "title": "QQ bot outbound message",
  "type": "object",
  "required": [
    "schema_version", "message_id", "request_id", "session_id", "report_id",
    "target", "delivery_status", "kind", "message_index", "message_count", "text", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "oopz.qq.message.v1"},
    "message_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "anyOf": [{"format": "uuid"}, {"pattern": "^\\d{4}-\\d{2}-\\d{2}_\\d{2}-\\d{2}-\\d{2}_BJT(?:-\\d{2,3})?$"}]},
    "report_id": {"type": "string", "format": "uuid"},
    "target": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["group", "private", "unconfigured"]},
        "id": {"type": "string"}
      }
    },
    "delivery_status": {"enum": ["pending", "target_required", "sent", "failed"]},
    "kind": {"const": "report"},
    "message_index": {"type": "integer", "minimum": 1},
    "message_count": {"type": "integer", "minimum": 1},
    "text": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
