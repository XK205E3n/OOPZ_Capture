{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oopz.continuous.request.v1",
  "title": "Continuous OOPZ capture request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "request_id", "area_id", "channel_id", "consent_confirmed"],
  "properties": {
    "schema_version": {"const": "oopz.continuous.request.v1"},
    "command": {"const": "start_continuous_capture"},
    "request_id": {"type": "string", "format": "uuid"},
    "area_id": {"type": "string", "minLength": 1},
    "channel_id": {"type": "string", "minLength": 1},
    "consent_confirmed": {"const": true},
    "chunk_seconds": {"type": "integer", "minimum": 30, "maximum": 300, "default": 300},
    "short_summary_seconds": {"const": 300},
    "long_summary_seconds": {"const": 3600},
    "cutoff_local_hour": {"type": "integer", "minimum": 0, "maximum": 23, "default": 4},
    "language": {"enum": ["auto", "zh", "en", "yue", "ja", "ko"], "default": "auto"},
    "retain_audio": {"type": "boolean", "default": false},
    "processing_deadline_seconds": {"type": "integer", "minimum": 60, "maximum": 3600, "default": 900},
    "retention_hours": {"type": "integer", "minimum": 1, "maximum": 168, "default": 168},
    "poll_interval_seconds": {"type": "number", "minimum": 0.05, "maximum": 5, "default": 0.25},
    "membership_refresh_seconds": {"type": "number", "minimum": 5, "maximum": 600, "default": 30},
    "membership_timeout_seconds": {"type": "number", "minimum": 1, "maximum": 60, "default": 10},
    "empty_channel_timeout_seconds": {"type": "number", "minimum": 5, "maximum": 3600, "default": 300},
    "connection_check_seconds": {"type": "number", "minimum": 0.5, "maximum": 30, "default": 2},
    "disconnect_grace_seconds": {"type": "number", "minimum": 3, "maximum": 120, "default": 15},
    "browser_operation_timeout_seconds": {"type": "number", "minimum": 0.5, "maximum": 15, "default": 2},
    "reconnect_window_seconds": {"type": "number", "minimum": 30, "maximum": 3600, "default": 300},
    "reconnect_initial_delay_seconds": {"type": "number", "minimum": 0.25, "maximum": 60, "default": 1},
    "reconnect_max_delay_seconds": {"type": "number", "minimum": 1, "maximum": 300, "default": 30},
    "reconnect_attempt_timeout_seconds": {"type": "number", "minimum": 5, "maximum": 120, "default": 30},
    "rtc_uid": {"type": ["string", "null"]},
    "requested_by": {"type": ["object", "null"]},
    "max_runtime_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0}
  }
}
