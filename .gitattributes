# Line endings and permissions for cross-platform deployment.
# Bash scripts and systemd/logrotate files must keep LF even when the repo is
# checked out on Windows, otherwise they break on Linux servers.
*.sh text eol=lf
*.service text eol=lf
*.logrotate text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.mjs text eol=lf
*.py text eol=lf
